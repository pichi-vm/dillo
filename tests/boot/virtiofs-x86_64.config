# Required builtin subset of arch/x86/configs/ch_defconfig from
# https://github.com/cloud-hypervisor/linux/tree/ch-release-v6.12.8-20250613
# Paired with the SHA-256-pinned image in virtiofs.rs, not a kernel build input.
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y

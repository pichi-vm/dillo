import "wtypes.idl";

[uuid(44958581-42fc-4713-a457-cd403414a5bb), version(1.0), pointer_default(unique)]
interface LocalMessage
{
    typedef GUID Connection;
    typedef [system_handle(sh_event)] HANDLE EventHandle;
    typedef [system_handle(sh_section)] HANDLE SectionHandle;
    typedef [system_handle(sh_file)] HANDLE FileHandle;
    typedef [system_handle(sh_pipe)] HANDLE PipeHandle;
    typedef [switch_type(unsigned long)] union {
        [case(1)] EventHandle event_handle;
        [case(2)] SectionHandle section_handle;
        [case(3)] FileHandle file_handle;
        [case(4)] PipeHandle pipe_handle;
    } Object;
    typedef struct {
        unsigned long kind;
        [switch_is(kind)] Object object;
    } Resource;
    typedef struct {
        [range(0, 65536)] unsigned long length;
        [size_is(length)] byte *bytes;
        [range(0, 240)] unsigned long count;
        [size_is(count)] Resource *resources;
    } Packet;

    unsigned long Open([in] handle_t binding, [out] Connection *connection,
                       [out] PipeHandle *lifetime);
    unsigned long Send([in] handle_t binding,
                       [in] Connection connection,
                       [in] Packet *packet);
    unsigned long Receive([in] handle_t binding,
                          [in] Connection connection,
                          [out] Packet *packet);
}
